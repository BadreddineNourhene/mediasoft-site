# --- Modèle de langage : groq | gemini | openrouter | nvidia | extractif ---
#   Plusieurs, séparés par des virgules, sont essayés dans l'ordre si le précédent échoue.
#   Chaque *_MODEL peut aussi lister plusieurs modèles : un modèle qui atteint son quota est mis en pause
#   LLM_COOLDOWN secondes et le suivant répond ; une question n'attend jamais plus de LLM_DEADLINE secondes.
#   groq       : clé gratuite sur https://console.groq.com/keys
#   gemini     : clé gratuite sur https://aistudio.google.com/apikey
#   openrouter : clé gratuite sur https://openrouter.ai/keys (modèles terminant par « :free »)
#   nvidia     : clé gratuite sur https://build.nvidia.com (bouton « Get API Key »)
#   extractif  : sans modèle de langage, renvoie les passages trouvés (dernier secours)
LLM_PROVIDER=groq,openrouter,nvidia,extractif

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,nvidia/nemotron-3.5-super-vl:free,nvidia/nemotron-3-ultra-550b-a55b:free,poolside/laguna-s-2.1:free,dots-studio/dots-3-note-preview:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free

NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-20b,nvidia/nemotron-3-ultra-550b-a55b,minimaxai/minimax-m3.1-flash

LLM_COOLDOWN=120
LLM_DEADLINE=60

# Sites autorisés à appeler l'API (séparés par des virgules)
ALLOWED_ORIGINS=http://127.0.0.1:3300,http://localhost:3000,https://mediasoft-site.onrender.com,https://www.mediasoft.tn,https://mediasoft.tn

# Pages du nouveau site exportées (dossier out/ de Next.js), lues par ingest.py
SITE_OUT_DIR=../out

# Recherche web de secours quand la base n'a pas la réponse (limitée aux sites officiels).
# Clé gratuite (1 000 recherches/mois) sur https://app.tavily.com ; vide = recherche web désactivée.
TAVILY_API_KEY=
